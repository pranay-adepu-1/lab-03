    {
      "name": "2. GET /books - Success Cases (Search, Sort, Pagination, Filter)",
      "item": [
        {
          "name": "GET All Books (Default query params)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns list of books and pagination info\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.books).to.be.an(\"array\");",
                  "    pm.expect(data.limit).to.eql(10);",
                  "    pm.expect(data.offset).to.eql(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Books - search_q=Clean (LIKE filter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search_q=Clean",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "search_q", "value": "Clean" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Title matches query\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.books.length).to.be.above(0);",
                  "    pm.expect(data.books[0].title).to.include(\"Clean\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Books - order_by=price&order=DESC (Sort high to low)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=price&order=DESC&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "order_by", "value": "price" },
                { "key": "order", "value": "DESC" },
                { "key": "limit", "value": "5" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Books sorted descending by price\", function () {",
                  "    var data = pm.response.json();",
                  "    var prices = data.books.map(b => b.price);",
                  "    for(var i = 1; i < prices.length; i++) {",
                  "        pm.expect(prices[i-1]).to.be.at.least(prices[i]);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Books - min_price=30&max_price=50 (BETWEEN filter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?min_price=30&max_price=50",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "min_price", "value": "30" },
                { "key": "max_price", "value": "50" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"All book prices between 30 and 50\", function () {",
                  "    var data = pm.response.json();",
                  "    data.books.forEach(b => {",
                  "        pm.expect(b.price).to.be.at.least(30);",
                  "        pm.expect(b.price).to.be.at.most(50);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Books - limit=2&offset=2 (Pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?limit=2&offset=2",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "limit", "value": "2" },
                { "key": "offset", "value": "2" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns exactly 2 books with offset 2\", function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data.books.length).to.eql(2);",
                  "    pm.expect(data.offset).to.eql(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
